# Copy this file to .env and fill in your own values.
# Use your OWN Jotform account/credentials — never production or customer data.

JOTFORM_API_KEY=

# Optional MCP Apps UI artifact override. When empty, the server first checks
# mcp_server/assets/workflow-mcp-ui.html and then the sibling frontend workspace.
WORKFLOW_MCP_UI_HTML_PATH=

# OpenAI Secure Tunnel / tunnel-client settings.
# The MCP server itself does not call OpenAI with these; the tunnel profile
# uses them to expose run_server.sh to ChatGPT.
OPENAI_API_KEY=
TUNNEL_ID=

# Base URLs — kept as separate vars because they behave very differently.
# See docs/gap-report.md for why.
JOTFORM_PUBLIC_API_BASE=https://api.jotform.com
JOTFORM_INTERNAL_BFF_BASE=https://www.jotform.com/API

# A form/workflow id from your own account, used by probe scripts as a
# default test target. Optional — probes will prompt or skip if unset.
TEST_FORM_ID=
TEST_WORKFLOW_ID=
TEST_SUBMISSION_ID=
GEMINI_API_KEY=
# Optional HTTPS UMD used by the embedded Workflow settings PoC.
# WORKFLOW_SETTINGS_RUNTIME_URL=https://your-rds-host/s/umd/dev/for-workflow-settings.js
