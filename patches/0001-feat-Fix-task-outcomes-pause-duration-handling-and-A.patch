+class RecordingMCP:
+    """The tiny part of MCPServer needed to get registered Python tools."""
+
+    def __init__(self):
+        self.tools = {}
+
+    def tool(self):
+        def register(function):
+            self.tools[function.__name__] = function
+            return function
+        return register
+
+
+class InMemoryTreeClient:
+    def __init__(self):
+        self.set_trigger_calls = 0
+        self.elements = {
+            "1": {
+                "element_id": 1,
+                "type": "workflow_start_point",
+                "position": {"x": 0, "y": 0},
+            },
+            "2": {
+                "element_id": 2,
+                "type": "workflow_binary_decision",
+                "position": {"x": 100, "y": 200},
+                "outcomes": [
+                    {"outcomeID": 1, "conditionValue": "TRUE", "linkID": None},
+                    {"outcomeID": 2, "conditionValue": "FALSE", "linkID": None},
+                ],
+            },
+        }
+        self.links = {}
+
+    def get_elements(self, workflow_id):
+        return copy.deepcopy(list(self.elements.values()))
+
+    def create_workflow(self, title):
+        return {"id": "workflow-created", "title": title}
+
+    def get_element(self, workflow_id, element_id):
+        return copy.deepcopy(self.elements[str(element_id)])
+
+    def get_links(self, workflow_id):
+        return copy.deepcopy(list(self.links.values()))
+
+    def get_workflow_combined(self, workflow_id):
+        return {"elements": self.get_elements(workflow_id), "links": self.get_links(workflow_id)}
+
+    def update_tree(self, workflow_id, *, elements=None, links=None):
+        for change in elements or []:
+            action = change["action"]
+            element_id = str(change["elementID"])
+            if action == "create":
+                self.elements[element_id] = copy.deepcopy(change["data"])
+            elif action == "update":
+                self.elements[element_id].update(copy.deepcopy(change["data"]))
+            else:  # pragma: no cover - not exercised by these building tests
+                raise AssertionError(f"Unexpected element action: {action}")
+        for change in links or []:
+            link_id = str(change["linkID"])
+            if change["action"] == "create":
+                self.links[link_id] = copy.deepcopy(change["data"])
+            elif change["action"] == "delete":
+                self.links.pop(link_id, None)
+            else:  # pragma: no cover - not exercised by these building tests
+                raise AssertionError(f"Unexpected link action: {change['action']}")
+        return {}
+
+    def set_trigger_form(self, workflow_id, form_id):
+        self.set_trigger_calls += 1
+        self.elements["1"].update({
+            "resourceID": str(form_id),
+            "resourceType": "FORM",
+            "subType": "workflow_start_point_submission",
+        })
+        return {}
+
+    def get_form_questions(self, form_id):
+        return {
+            "5": {
+                "qid": "5",
+                "text": "Rating",
+                "type": "control_dropdown",
+                "options": "5 - Excellent|4 - Good|3 - Okay",
+            },
+            "8": {
+                "qid": "8",
+                "text": "Budget",
+                "type": "control_number",
+            },
+        }
+
+
+class NormalisingTreeClient(InMemoryTreeClient):
+    """Matches API behaviour observed live: numeric config may read as text."""
+
+    def update_tree(self, workflow_id, *, elements=None, links=None):
+        result = super().update_tree(workflow_id, elements=elements, links=links)
+        for change in elements or []:
+            if change["action"] != "create":
+                continue
+            stored = self.elements[str(change["elementID"])]
+            if "width" in stored:
+                stored["width"] = str(stored["width"])
+            if "enabled" in stored and isinstance(stored["enabled"], bool):
+                stored["enabled"] = "1" if stored["enabled"] else "0"
+        return result
+
+
+class DroppingPauseClient(InMemoryTreeClient):
+    """Models the public API silently discarding an incorrectly shaped pause."""
+
+    def update_tree(self, workflow_id, *, elements=None, links=None):
+        filtered = copy.deepcopy(elements or [])
+        for change in filtered:
+            change.get("data", {}).pop("pause", None)
+        return super().update_tree(workflow_id, elements=filtered, links=links)
+
