+def missing_create_fields(step_type: str, config: dict) -> list[str]:
+    """Return configuration paths required for a usable newly added step.
+
+    These checks mirror the builder's own publish/error rules for step types
+    where the API can persist an unusable blank shell.  Missing requirements
+    are reported before any write happens.
+    """
+    resolved = resolve_step_type(step_type)
+    canonical_type = resolved["canonical_type"]
+    subtype = resolved["subtype"] or config.get("subType")
+    required = AI_CREATE_REQUIRED_FIELDS.get(canonical_type, ())
+    missing = [
+        name for name in required
+        if not isinstance(config.get(name), str) or not config[name].strip()
+    ]
+
+    def has_value(value) -> bool:
+        if value is None:
+            return False
+        if isinstance(value, str):
+            return bool(value.strip())
+        if isinstance(value, (list, tuple, set, dict)):
+            return bool(value)
+        return True
+
+    def require(path: str, value) -> None:
+        if not has_value(value) and path not in missing:
+            missing.append(path)
+
+    if canonical_type == "workflow_send_email":
+        require("to", config.get("to"))
+        # PDF and Flow Report have their own builder dialogs. They require a
+        # recipient (and PDF requires a source), but those dialogs do not
+        # expose a normal Email subject/body pair.
+        if subtype not in {"workflow_send_pdf", "workflow_send_approval_report"}:
+            require("subject", config.get("subject"))
+            require("content", config.get("content"))
+        if subtype == "workflow_send_pdf":
+            require(
+                "pdfDocuments/pdfId/attachment",
+                config.get("pdfDocuments") or config.get("pdfId") or config.get("attachment"),
+            )
+
+    elif canonical_type == "workflow_assign_task":
+        require("name", config.get("name"))
+        require("assignee", config.get("assignee"))
+
+    elif canonical_type == "workflow_assign":
+        require("assignee", config.get("assignee"))
+
+    elif canonical_type in {"workflow_approval", "workflow_payment_verification"}:
+        if subtype == "workflow_team_approval":
+            require("team", config.get("team"))
+        else:
+            require("approver", config.get("approver"))
+        if canonical_type == "workflow_payment_verification":
+            require("formID", config.get("formID"))
+
+    elif canonical_type == "workflow_assign_form":
+        require("formID", config.get("formID"))
+        require("assignee", config.get("assignee"))
+
+    elif canonical_type == "workflow_sign_document":
+        require("documentID", config.get("documentID"))
+        signer_mapping = config.get("signerMapping")
+        participants = [
+            entry for entry in (signer_mapping or [])
+            if isinstance(entry, dict) and has_value(entry.get("fields"))
+        ] if isinstance(signer_mapping, list) else []
+        if not participants:
+            require("signerMapping", None)
+        elif any(
+            not has_value(entry.get("email")) or not has_value(entry.get("name"))
+            for entry in participants
+        ):
+            require("signerMapping[].name/email", None)
+
+    elif canonical_type == "workflow_webhook":
+        require("url", config.get("url"))
+
+    elif canonical_type == "workflow_integration":
+        require("integrationID", config.get("integrationID"))
+        require("actionType", config.get("actionType"))
+
+    elif canonical_type == "workflow_qr_code":
+        require("content", config.get("content"))
+
+    elif canonical_type == "workflow_collection":
+        require("dataType", config.get("dataType"))
+        sheets = config.get("sheets")
+        selected_sheet = sheets[0] if isinstance(sheets, list) and sheets else {}
+        require(
+            "sheets[0].sheetID",
+            selected_sheet.get("sheetID") if isinstance(selected_sheet, dict) else None,
+        )
+
