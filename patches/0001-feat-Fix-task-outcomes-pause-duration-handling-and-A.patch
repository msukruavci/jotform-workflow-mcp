+"""Wire-format tests for Workflow's flattened element properties."""
+from __future__ import annotations
+
+import pytest
+import requests
+
+from mcp_server.jotform_client import (
+    JotformAPIError,
+    JotformClient,
+    flatten_element_properties,
+    unflatten_element_properties,
+)
+
+
+def test_pause_config_is_flattened_like_the_frontend_update_tree_payload():
+    payload = {
+        "element_id": "5",
+        "name": "1 Gün Bekle",
+        "position": {"x": 0, "y": 180},
+        "pause": {
+            "activated": "Yes",
+            "executeWhen": {"afterAmount": "1", "afterUnit": "day"},
+        },
+    }
+
+    assert flatten_element_properties(payload) == {
+        "element_id": "5",
+        "name": "1 Gün Bekle",
+        "position__x": 0,
+        "position__y": 180,
+        "pause__activated": "Yes",
+        "pause__executeWhen__afterAmount": "1",
+        "pause__executeWhen__afterUnit": "day",
+    }
+
+
+def test_flattening_keeps_arrays_and_assignment_options_intact():
+    payload = {
+        "pause": {"executeWhen": {"afterAmount": "1", "afterUnit": "day"}},
+        "outcomes": [{"id": 1, "text": "Complete"}],
+        "assignmentOptions": {"nested": {"kept": True}},
+    }
+
+    flattened = flatten_element_properties(payload)
+
+    assert flattened["outcomes"] == [{"id": 1, "text": "Complete"}]
+    assert flattened["assignmentOptions"] == {"nested": {"kept": True}}
+
+
+def test_flattened_api_readback_is_unflattened_for_mcp_tools():
+    response = {
+        "element_id": "5",
+        "pause__activated": "Yes",
+        "pause__executeWhen__afterAmount": "1",
+        "pause__executeWhen__afterUnit": "day",
+    }
+
+    assert unflatten_element_properties(response) == {
+        "element_id": "5",
+        "pause": {
+            "activated": "Yes",
+            "executeWhen": {"afterAmount": "1", "afterUnit": "day"},
+        },
+    }
+
+
+def test_network_error_never_exposes_api_key(monkeypatch):
+    secret = "super-secret-jotform-key"
+
+    def fail(*args, **kwargs):
+        raise requests.ConnectionError(
+            f"failed for https://api.jotform.com/user/forms?apiKey={secret}"
+        )
+
+    monkeypatch.setattr(requests, "request", fail)
+    client = JotformClient(secret)
+
+    with pytest.raises(JotformAPIError) as captured:
+        client.list_forms()
+
+    assert secret not in str(captured.value)
+    assert "ConnectionError" in str(captured.value)
+
+
+def test_error_response_redacts_api_key(monkeypatch):
+    secret = "super-secret-jotform-key"
+
+    class Response:
+        status_code = 401
+        text = f"Unauthorized apiKey={secret}"
+
+    monkeypatch.setattr(requests, "request", lambda *args, **kwargs: Response())
+
+    with pytest.raises(JotformAPIError) as captured:
+        JotformClient(secret).list_forms()
+
+    assert secret not in str(captured.value)
+    assert "[REDACTED]" in str(captured.value)
+
+
+def test_success_with_invalid_json_becomes_readable_api_error(monkeypatch):
+    class Response:
+        status_code = 200
+        text = "not-json"
+
+        def json(self):
+            raise ValueError("bad json")
+
+    monkeypatch.setattr(requests, "request", lambda *args, **kwargs: Response())
+
+    with pytest.raises(JotformAPIError, match="Invalid JSON response"):
+        JotformClient("key").list_forms()
