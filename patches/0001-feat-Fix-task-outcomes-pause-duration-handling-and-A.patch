+def _numeric_value(value) -> Decimal | None:
+    """Parse API-normalised numbers without treating booleans as numbers."""
+    if isinstance(value, bool) or not isinstance(value, (int, float, str)):
+        return None
+    if isinstance(value, str) and not value.strip():
+        return None
+    try:
+        return Decimal(str(value).strip())
+    except InvalidOperation:
+        return None
+
+
+def values_equivalent(actual, expected) -> bool:
+    """Compare a requested value with Jotform's normalised read-back value.
+
+    Jotform commonly serialises numbers and booleans as strings and may add
+    bookkeeping fields inside objects. Those changes are accepted; missing
+    requested data, changed text, changed list order or a different value is
+    still rejected.
+    """
+    if actual == expected and type(actual) is type(expected):
+        return True
+    if isinstance(expected, dict):
+        return isinstance(actual, dict) and all(
+            key in actual and values_equivalent(actual[key], value)
+            for key, value in expected.items()
+        )
+    if isinstance(expected, list):
+        return (
+            isinstance(actual, list)
+            and len(actual) == len(expected)
+            and all(values_equivalent(a, e) for a, e in zip(actual, expected))
+        )
+    if isinstance(actual, bool) or isinstance(expected, bool):
+        def boolean_value(value):
+            if isinstance(value, bool):
+                return value
+            if isinstance(value, (str, int)):
+                normalised = str(value).strip().lower()
+                if normalised in {"1", "true", "yes"}:
+                    return True
+                if normalised in {"0", "false", "no"}:
+                    return False
+            return None
+
+        actual_boolean = boolean_value(actual)
+        expected_boolean = boolean_value(expected)
+        return actual_boolean is not None and actual_boolean is expected_boolean
+    # Only use numeric equivalence when at least one side is a real number.
+    # Two strings such as form ids must remain exact strings.
+    if (
+        isinstance(actual, (int, float)) and not isinstance(actual, bool)
+        or isinstance(expected, (int, float)) and not isinstance(expected, bool)
+    ):
+        actual_number = _numeric_value(actual)
+        expected_number = _numeric_value(expected)
+        return (
+            actual_number is not None
+            and expected_number is not None
+            and actual_number == expected_number
+        )
+    return actual == expected
