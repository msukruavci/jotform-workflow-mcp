@@ -0,0 +1,18 @@
+"""Create a fully registered MCP server for any supported transport."""
+from __future__ import annotations
+
+from mcp.server import MCPServer
+
+from mcp_server.jotform_client import JotformClient
+from mcp_server.tools import building, discovery, reading, risky
+
+
+def create_mcp_server(client: JotformClient | None = None) -> MCPServer:
+    """Register the same tool set for stdio and Streamable HTTP."""
+    server = MCPServer("jotform-workflow")
+    active_client = client or JotformClient()
+    discovery.register(server)
+    reading.register(server, active_client)
+    building.register(server, active_client)
+    risky.register(server, active_client)
+    return server
