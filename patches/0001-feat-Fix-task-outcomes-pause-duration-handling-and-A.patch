+import os
+import secrets
+import sys
+
+import uvicorn
+from dotenv import load_dotenv
+from mcp.server.transport_security import TransportSecuritySettings
+from starlette.applications import Starlette
+from starlette.middleware.base import BaseHTTPMiddleware
+from starlette.requests import Request
+from starlette.responses import JSONResponse, Response
+
+from mcp_server.factory import create_mcp_server
+
+load_dotenv()
+
+logging.basicConfig(
+    level=logging.INFO,
+    format="%(asctime)s  %(levelname)-8s  %(name)s  %(message)s",
+    stream=sys.stderr,
+)
+logger = logging.getLogger("server_http")
+
+# ---------------------------------------------------------------------------
+# Auth middleware
+# ---------------------------------------------------------------------------
+# Allowed API keys: single key from .env (or override via env at startup)
+# ChatGPT sends: Authorization: Bearer <key>
+# Claude sends:  Authorization: Bearer <key>  (same)
+# You can also send: X-API-Key: <key>  (Bruno / manual testing)
+# ---------------------------------------------------------------------------
+
+class APIKeyMiddleware(BaseHTTPMiddleware):
+    """Rejects requests that don't carry a valid API key."""
+
+    def __init__(self, app, valid_keys: set[str]):
+        super().__init__(app)
+        self.valid_keys = valid_keys
+
+    async def dispatch(self, request: Request, call_next):
+        # Health-check endpoint passes through without auth
+        if request.url.path in ("/health", "/"):
+            return await call_next(request)
+
+        key = self._extract_key(request)
+        if key and any(secrets.compare_digest(key, valid) for valid in self.valid_keys):
+            return await call_next(request)
+
+        logger.warning("Rejected request — missing or invalid API key (path=%s)", request.url.path)
+        return JSONResponse(
+            {"error": "Unauthorized", "detail": "Provide a valid API key via 'Authorization: Bearer <key>' or 'X-API-Key: <key>'"},
+            status_code=401,
+        )
+
+    @staticmethod
+    def _extract_key(request: Request) -> str | None:
+        # Authorization: Bearer <key>
+        auth = request.headers.get("authorization", "")
+        if auth.lower().startswith("bearer "):
+            return auth[7:].strip()
+        # X-API-Key: <key>
+        return request.headers.get("x-api-key", "").strip() or None
+
+
+# ---------------------------------------------------------------------------
+# Health / root endpoints
+# ---------------------------------------------------------------------------
+async def health(_request: Request) -> Response:
+    return JSONResponse({"status": "ok", "server": "jotform-workflow-mcp"})
+
+
+# ---------------------------------------------------------------------------
+# App factory
+# ---------------------------------------------------------------------------
+def build_app(
+    valid_keys: set[str],
+    auth_enabled: bool,
+    stateless: bool,
+    *,
+    allowed_hosts: list[str] | None = None,
+    allowed_origins: list[str] | None = None,
+) -> Starlette:
+    mcp = create_mcp_server()
+    # mcp.streamable_http_app() automatically creates the Starlette app with correct lifespan
+    app = mcp.streamable_http_app(
+        stateless_http=stateless,
+        streamable_http_path="/mcp",
+        json_response=False,
+        transport_security=TransportSecuritySettings(
+            enable_dns_rebinding_protection=bool(allowed_hosts),
+            allowed_hosts=allowed_hosts or [],
+            allowed_origins=allowed_origins or [],
+        ),
+    )
+
+    # Add our auth middleware on top only if auth is enabled
+    if auth_enabled:
+        app.add_middleware(
+            APIKeyMiddleware,
+            valid_keys=valid_keys,
+        )
+
+    # Add health checks
+    app.add_route("/health", health, methods=["GET"])
+    app.add_route("/", health, methods=["GET"])
+
+    return app
+
+
+def environment_list(name: str) -> list[str]:
+    """Read a comma-separated environment setting without hidden fallbacks."""
+    return [item.strip() for item in os.getenv(name, "").split(",") if item.strip()]
+
+
+# ---------------------------------------------------------------------------
+# CLI entry point
+# ---------------------------------------------------------------------------
+def main():
+    parser = argparse.ArgumentParser(description="Jotform Workflow MCP HTTP Server")
+    parser.add_argument("--port", type=int, default=int(os.getenv("MCP_HTTP_PORT", "8000")))
+    parser.add_argument("--host", default=os.getenv("MCP_HTTP_HOST", "0.0.0.0"))
+    parser.add_argument("--no-auth", action="store_true", help="Disable API key authentication (only for local testing)")
+    parser.add_argument("--stateless", action="store_true", help="Stateless mode: no session tracking (simpler, lower memory)")
+    args = parser.parse_args()
+
+    # Collect valid API keys from environment
+    # Supports multiple keys separated by commas: MCP_API_KEYS=key1,key2
+    valid_keys = set(environment_list("MCP_API_KEYS"))
+    allowed_hosts = environment_list("MCP_ALLOWED_HOSTS")
+    allowed_origins = environment_list("MCP_ALLOWED_ORIGINS")
+
+    auth_enabled = not args.no_auth
+    if auth_enabled and not valid_keys:
+        logger.error(
+            "No connector keys found! Set MCP_API_KEYS in .env, "
+            "or use --no-auth for local testing."
+        )
+        sys.exit(1)
+
+    if not auth_enabled:
+        logger.warning("⚠️  Authentication disabled — do NOT expose this publicly without auth!")
+    else:
+        logger.info("Auth enabled. %d key(s) accepted.", len(valid_keys))
+
+    if not allowed_hosts:
+        logger.warning(
+            "MCP_ALLOWED_HOSTS is empty, so DNS rebinding protection is disabled. "
+            "Set it to the public connector host (for example tunnel.example.com:*)."
+        )
+
+    app = build_app(
+        valid_keys=valid_keys,
+        auth_enabled=auth_enabled,
+        stateless=args.stateless,
+        allowed_hosts=allowed_hosts,
+        allowed_origins=allowed_origins,
+    )
+
+    logger.info("Starting Jotform Workflow MCP HTTP server on %s:%d", args.host, args.port)
+    logger.info("MCP endpoint: http://%s:%d/mcp", args.host, args.port)
+    logger.info("Health check: http://%s:%d/health", args.host, args.port)
+
+    uvicorn.run(
+        app,
+        host=args.host,
+        port=args.port,
+        log_level="info",
+    )
+
+
+if __name__ == "__main__":
+    main()
