new file mode 100644
index 0000000..a53a3f0
--- /dev/null
+++ b/tests/test_risky.py
@@ -0,0 +1,131 @@
+"""Behaviour tests for destructive tools without touching the real API."""
+from __future__ import annotations
+
+import copy
+
+from mcp_server.tools import risky
+
+
+class RecordingMCP:
+    def __init__(self):
+        self.tools = {}
+
+    def tool(self):
+        def register(function):
+            self.tools[function.__name__] = function
+            return function
+        return register
+
+
+class DeletionClient:
+    def __init__(self):
+        self.elements = {
+            "1": {"element_id": 1, "type": "workflow_start_point"},
+            "2": {
+                "element_id": 2,
+                "type": "workflow_assign_task",
+                "name": "Review",
+                "outcomes": [
+                    {"id": 1, "outcomeID": 1, "text": "Complete", "linkID": 7}
+                ],
+            },
+            "3": {"element_id": 3, "type": "workflow_send_email", "name": "Notify"},
+        }
+        self.links = {
+            "7": {"link_id": 7, "fromElement": 2, "toElement": 3}
+        }
+
+    def get_element(self, workflow_id, element_id):
+        return copy.deepcopy(self.elements[str(element_id)])
+
+    def get_elements(self, workflow_id):
+        return copy.deepcopy(list(self.elements.values()))
+
+    def get_links(self, workflow_id):
+        return copy.deepcopy(list(self.links.values()))
+
+    def update_tree(self, workflow_id, *, elements=None, links=None):
+        for change in elements or []:
+            element_id = str(change["elementID"])
+            if change["action"] == "update":
+                self.elements[element_id].update(copy.deepcopy(change["data"]))
+            elif change["action"] == "delete":
+                self.elements.pop(element_id, None)
+        for change in links or []:
+            if change["action"] == "delete":
+                self.links.pop(str(change["linkID"]), None)
+        return {}
+
+
+class PublishClient:
+    def __init__(self, live):
+        self.live = live
+
+    def get_workflow_combined(self, workflow_id):
+        return {
+            "elements": [{"element_id": 1, "type": "workflow_start_point"}],
+            "links": [],
+        }
+
+    def publish_workflow(self, workflow_id):
+        return {"live": self.live}
+
+
+def test_delete_step_clears_incoming_branch_outcome_mapping():
+    mcp = RecordingMCP()
+    client = DeletionClient()
+    risky.register(mcp, client)
+
+    result = mcp.tools["delete_step"]("workflow-1", "3", True)
+
+    assert result.deleted is True
+    assert result.verified is True
+    assert "3" not in client.elements
+    assert client.links == {}
+    assert client.elements["2"]["outcomes"][0]["linkID"] is None
+
+
+def test_delete_step_preview_changes_nothing():
+    mcp = RecordingMCP()
+    client = DeletionClient()
+    risky.register(mcp, client)
+
+    result = mcp.tools["delete_step"]("workflow-1", "3", False)
+
+    assert result.needs_confirmation is True
+    assert "3" in client.elements
+    assert "7" in client.links
+    assert client.elements["2"]["outcomes"][0]["linkID"] == 7
+
+
+def test_delete_step_refuses_to_delete_the_start_point():
+    mcp = RecordingMCP()
+    client = DeletionClient()
+    risky.register(mcp, client)
+
+    result = mcp.tools["delete_step"]("workflow-1", "1", True)
+
+    assert result.deleted is False
+    assert "cannot be deleted" in result.error
+    assert "1" in client.elements
+
+
+def test_publish_does_not_treat_string_zero_as_live():
+    mcp = RecordingMCP()
+    risky.register(mcp, PublishClient("0"))
+
+    result = mcp.tools["publish_workflow"]("workflow-1", True)
+
+    assert result.published is False
+    assert result.verified is False
+    assert "did not return live=1" in result.error
+
+
+def test_publish_accepts_normalised_live_one():
+    mcp = RecordingMCP()
+    risky.register(mcp, PublishClient("1"))
+
+    result = mcp.tools["publish_workflow"]("workflow-1", True)
+
+    assert result.published is True
+    assert result.verified is True
